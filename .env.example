# Your custom router endpoint (e.g., vLLM, Ollama, LocalAI, etc.)
OPENAI_BASE_URL=http://localhost:9000/v1

# API key (set to "not-needed" if not required)
OPENAI_API_KEY=not-needed

# Model name as served by your endpoint
MODEL_NAME=llama3-70b-8192